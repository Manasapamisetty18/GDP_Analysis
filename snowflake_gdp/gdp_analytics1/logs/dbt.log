create or replace   view GDP_ANALYTICS.DW.fact_econ_observation
  
  
  
  
  as (
    select
    c.sk_country,
    i.sk_indicator,
    d.sk_date,
    o.value,
    o.source_system,
    o.vintage_date
from GDP_ANALYTICS.DW.stg_observations o
join GDP_ANALYTICS.DW.dim_country c
    on o.country_id = c.country_id
join GDP_ANALYTICS.DW.dim_indicator i
    on o.indicator_id = i.indicator_id
join GDP_ANALYTICS.DW.dim_date d
    on o.year = d.year
  )
